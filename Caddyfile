# Caddy — reverse proxy + HTTPS automático (Let's Encrypt) para o DeskcommCRM.
# HTTP→HTTPS e emissão/renovação de certificado são automáticos.

{
	email {$ACME_EMAIL}
}

{$DOMAIN} {
	encode gzip

	# Access log — POR QUE EXISTE: em 2026-09-05 o site entrou em loop de
	# redirecionamento onze vezes, entre 11:45 e 15:25 UTC, e tres dias depois
	# foi impossivel dizer QUAL rota redirecionava para qual — porque não havia
	# registro de requisição nenhuma. O Caddy não logava acesso, e o app não
	# escreveu uma linha sequer naquela janela. A causa morreu com o incidente.
	#
	# Vai para o stdout de propósito: o Docker já rotaciona este contêiner em
	# 10 MB × 3 (`logging: *default-logging` no compose). Um log de acesso em
	# arquivo, sem teto, é o jeito clássico de encher o disco de uma VPS.
	#
	# O Caddy já omite `Cookie` e `Authorization` do log por padrão, então isto
	# não passa a gravar sessão de ninguém.
	log {
		output stdout
		format json
	}

	# `route` é obrigatório aqui: fora dele o Caddy reordena as diretivas pela
	# ordem padrão dele, na qual `respond` vem DEPOIS de `reverse_proxy` — o
	# catch-all atendia primeiro e o 403 abaixo nunca era alcançado (medido: o
	# POST sem assinatura ainda respondia 200). Dentro de `route`, vale a ordem
	# escrita.
	route {
		# HSTS — o navegador passa a RECUSAR http:// neste domínio por um ano,
		# sem esperar o redirecionamento.
		#
		# O 308 de http→https já existe, mas ele só age DEPOIS que a primeira
		# requisição saiu em texto claro: numa rede pública, esse instante é
		# onde a sessão é roubada. O cabeçalho fecha a janela a partir da
		# primeira visita bem-sucedida.
		#
		# `includeSubDomains` alcança só o que está ABAIXO deste host (isto é,
		# *.crm.…), não o domínio principal da empresa — então não afeta site
		# institucional nem e-mail.
		#
		# SEM `preload`, de propósito: entrar na lista embutida dos navegadores
		# é praticamente irreversível e vale para o domínio inteiro. Aqui o
		# cabeçalho expira sozinho se um dia for removido.
		#
		# ⚠️ Contrapartida real: com HSTS, certificado vencido vira site
		# INACESSÍVEL, sem a tela de "prosseguir mesmo assim". O Caddy renova
		# sozinho, mas se a renovação quebrar, o sintoma é o site sumir.
		header Strict-Transport-Security "max-age=31536000; includeSubDomains"

		# O webhook GLOBAL do WAHA (sem token na URL) não é publicado na internet.
		#
		# Nesta stack o WAHA fala com o app pela rede interna do Docker
		# (http://app:3000/api/v1/webhooks/waha), então essa rota nunca precisou ser
		# alcançável de fora — e estando aberta, qualquer pessoa que soubesse o
		# endereço injetava mensagem falsa no CRM, escolhia o remetente e fazia o
		# WhatsApp do dono responder para um número arbitrário (queimando o
		# orçamento de IA e arriscando banimento do número).
		#
		# Quem roda o WAHA em OUTRO servidor deve usar a rota por tenant,
		# /api/v1/webhooks/waha/<token>, que carrega um token imprevisível na URL e
		# continua pública — é a variante canônica para essa topologia.
		@waha_global path /api/v1/webhooks/waha
		respond @waha_global 403

		# O runner de agente de IA (ToolLoop) pode levar até ~5min por requisição.
		# Timeout estendido só nessa rota pra o proxy não cortar a resposta longa.
		@agentrun path /api/internal/agents/run*
		reverse_proxy @agentrun app:3000 {
			transport http {
				read_timeout 320s
				write_timeout 320s
			}
		}

		# Todo o resto do app.
		reverse_proxy app:3000
	}
}
